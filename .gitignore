# Agent scratch and worktrees. These hold nested git worktrees
# (.claude/worktrees/) and per-plan execution state (.superpowers/sdd/);
# committing either would pull a whole second checkout into this repo.
.claude/
.superpowers/

# Python bytecode
__pycache__/
*.py[cod]
.pytest_cache/

# Regenerable or oversized local artefacts (never commit; see README
# "NERSC layout" for where the authoritative copies live)
# ODD field map + material maps (193 MB, from the ODD install)
data/
# 46 MB prediction array from the first value model
value_v0/
# 12 GB of chi2 calibration rows
experiments/chi2_gate_calib/
# 830 MB of window-failure intermediates
results/winfail_branches/
results/winfail_rows/
# ACTS run outputs
output/*.root
output/gate.bin
output/traces*.csv
output/calib_medium/
output/smoke/
# Optuna sqlite studies (trials.csv is committed instead)
*.db
# superseded optimizer copies; deleted on main in 17b57ea
optimization/
